# Native development and local Compose. Copy this file to .env.
# Set the password ONCE here. These values are also used to initialize PostgreSQL.
POSTGRES_USER=ficka
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=ficka
# Native API only: use a host address, never the Docker service name "db".
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Optional external PostgreSQL override (native API/Alembic only):
# DATABASE_URL=postgresql+psycopg://username:url-encoded-password@db.example:5432/ficka
# Native Next.js server only; pnpm dev loads this root .env.
API_INTERNAL_URL=http://127.0.0.1:8000
# Browser calls use the same origin; no CORS permission is needed by default.
CORS_ORIGINS=[]
WEB_PORT=3000
# Portainer-only optional overrides; otherwise main images and LAN binding are used:
# FICKA_WEB_IMAGE=ghcr.io/mathisvkg/ficka-web:sha-FULL_COMMIT_SHA
# FICKA_API_IMAGE=ghcr.io/mathisvkg/ficka-api:sha-FULL_COMMIT_SHA
# WEB_BIND_ADDRESS=0.0.0.0
